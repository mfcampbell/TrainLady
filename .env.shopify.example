# Copy these values into .env.local and your hosting provider's environment settings.
# Use the permanent Shopify hostname, without https:// or a trailing slash.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional public Storefront API token. Never use an Admin API or private token here.
# Basic products and cart operations support tokenless access.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
